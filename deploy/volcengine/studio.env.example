# Copy the field names to /etc/specialist-model-studio/studio.env on the
# Volcengine host. Keep the real file root:root mode 0600. Never commit values.

MODEL_HARNESS_DSH_CREDENTIALS_FILE=/opt/specialist-model-studio-data/secrets/.credentials.yaml
# Alternatively configure DEEPSEEK_API_KEY only in this root-only server file.
MODEL_HARNESS_AGENT_BRIDGE_TOKEN=replace-with-a-long-random-server-only-token
