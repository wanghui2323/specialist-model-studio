    {"id":"privacy_security", "cases":["ZIP路径穿越","材料提示词注入","凭据不入日志/模型包","隔离文件/进程/网络","来源与权重许可","原数据和测试答案不导出"]},
    {"id":"cost_performance", "cases":["首个有用回复延迟","总耗时/工具循环/无效轮数","模型token/实际费用","训练资源实测","状态投影性能","相同预算重复试验成功率"]},
    {"id":"portability", "cases":["下载包完整性","脱离原Run干净隔离环境重载","基座和适配器依赖","相同新输入回放","固定环境可重建"]}
