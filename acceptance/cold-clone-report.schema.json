{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wanghui2323/ai-pm-model-harness/acceptance/cold-clone-report.schema.json",
  "title": "Model Harness v0.7 Cold Clone Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "producer_run_id", "clone_method", "resolved_commit", "worktree_clean_before_run", "preexisting_runs", "preexisting_model_cache", "commands", "minimal_family_ids"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "producer_run_id": {"$ref": "#/$defs/runId"},
    "clone_method": {"const": "git_clone_no_local_no_hardlinks"},
    "resolved_commit": {"$ref": "#/$defs/commit"},
    "worktree_clean_before_run": {"type": "boolean"},
    "preexisting_runs": {"type": "boolean"},
    "preexisting_model_cache": {"type": "boolean"},
    "commands": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/command"}},
    "minimal_family_ids": {
      "type": "object", "additionalProperties": false, "required": ["image", "tabular", "audio"],
      "properties": {"image": {"$ref": "#/$defs/familyIds"}, "tabular": {"$ref": "#/$defs/familyIds"}, "audio": {"$ref": "#/$defs/familyIds"}}
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runId": {"type": "string", "pattern": "^evidence-[0-9TZ-]+-[0-9a-f]{8}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "command": {
      "type": "object", "additionalProperties": false, "required": ["id", "argv", "exit_code", "duration_seconds"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "exit_code": {"type": "integer"}, "duration_seconds": {"type": "number", "minimum": 0}}
    },
    "familyIds": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "run_id", "evaluation_report_id", "inference_check_id", "artifact_bundle_id"],
      "properties": {"task_id": {"$ref": "#/$defs/nonEmpty"}, "run_id": {"$ref": "#/$defs/nonEmpty"}, "evaluation_report_id": {"$ref": "#/$defs/nonEmpty"}, "inference_check_id": {"$ref": "#/$defs/nonEmpty"}, "artifact_bundle_id": {"$ref": "#/$defs/nonEmpty"}}
    }
  }
}
