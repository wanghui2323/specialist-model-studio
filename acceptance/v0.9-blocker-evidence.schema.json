{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-harness.local/acceptance/v0.9-blocker-evidence.schema.json",
  "title": "v0.9 BlockerEvidence",
  "description": "Immutable blocker fact. Resolution is represented by a separate BlockerResolution object; API-only active is not part of this sealed record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "blocker_id",
    "blocker_evidence_id",
    "task_id",
    "stage",
    "code",
    "detector",
    "facts",
    "rule",
    "evidence_refs",
    "recovery_actions",
    "retryable",
    "retry_action",
    "related_object_type",
    "related_object_id",
    "related_object_digest",
    "details",
    "message",
    "semantic_digest",
    "created_at",
    "created_at_utc",
    "resolved_by",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "object_type": {"const": "BlockerEvidence"},
    "blocker_id": {
      "type": "string",
      "pattern": "^blocker_[0-9a-f]{24}$"
    },
    "blocker_evidence_id": {
      "type": "string",
      "pattern": "^blocker_[0-9a-f]{24}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^/\\\\\\u0000]+$"
    },
    "stage": {
      "enum": [
        "source_discovery",
        "source_resolution",
        "source_snapshot",
        "repository_analysis",
        "training_plan",
        "resource_probe",
        "environment_lock",
        "resource_fit",
        "build",
        "run"
      ]
    },
    "code": {
      "enum": [
        "blocked_license",
        "blocked_security",
        "blocked_environment",
        "blocked_platform",
        "blocked_resources",
        "blocked_data",
        "blocked_repository",
        "qualification_failed"
      ]
    },
    "detector": {"type": "string", "minLength": 1, "maxLength": 160},
    "facts": {"type": "object"},
    "rule": {"type": "object"},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "recovery_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "retryable": {"type": "boolean"},
    "retry_action": {"type": "string", "minLength": 1, "maxLength": 120},
    "related_object_type": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 80
    },
    "related_object_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "related_object_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "details": {"type": "object"},
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "resolved_by": {"type": "null"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
