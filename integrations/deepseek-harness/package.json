{
  "name": "specialist-model-studio-dsh-plugin",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "DeepSeek Harness tools for Specialist Model Studio",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "presets/model-training/*"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
